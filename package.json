{
    "name": "@ims360/svelte-ivory",
    "version": "0.6.2",
    "keywords": [
        "svelte"
    ],
    "license": "MIT",
    "sideEffects": [
        "**/*.css"
    ],
    "type": "module",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ims360ca/svelte-ivory.git"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        },
        "./components/basic": {
            "types": "./dist/components/basic/index.d.ts",
            "svelte": "./dist/components/basic/index.js"
        },
        "./components/layout": {
            "types": "./dist/components/layout/index.d.ts",
            "svelte": "./dist/components/layout/index.js"
        },
        "./components/table": {
            "types": "./dist/components/table/index.d.ts",
            "svelte": "./dist/components/table/index.js"
        },
        "./components/inputs": {
            "types": "./dist/components/inputs/index.d.ts",
            "svelte": "./dist/components/inputs/index.js"
        },
        "./utils/attachments": {
            "types": "./dist/utils/attachments/index.d.ts",
            "svelte": "./dist/utils/attachments/index.js"
        },
        "./utils/functions": {
            "types": "./dist/utils/functions/index.d.ts",
            "svelte": "./dist/utils/functions/index.js"
        }
    },
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src/lib",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*",
        "!src/lib/**/*.test.*",
        "!src/lib/**/*.spec.*"
    ],
    "scripts": {
        "build": "vite build && npm run prepack",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "dev": "vite dev",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepack": "svelte-kit sync && svelte-package && publint",
        "prepare": "svelte-kit sync || echo ''",
        "preview": "vite preview",
        "test": "npm run test:unit -- --run",
        "test:unit": "vitest"
    },
    "dependencies": {
        "@lucide/svelte": "^1.70.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.5",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.17",
        "jsdom": "^27.4.0",
        "marked": "^17.0.6",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.5"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/kit": "^2.70.4",
        "@sveltejs/package": "^2.5.8",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@testing-library/jest-dom": "^6.10.0",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.8",
        "@vitest/browser": "^4.1.12",
        "@vitest/coverage-v8": "^4.1.12",
        "@vitest/spy": "^4.1.12",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.24.1",
        "globals": "^16.5.0",
        "playwright": "^1.65.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^3.5.2",
        "prettier-plugin-tailwindcss": "^0.7.4",
        "publint": "^0.3.25",
        "svelte-check": "^4.7.8",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^4.1.12",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@skeletonlabs/skeleton": "^5.0.0",
        "svelte": "^5.55.1"
    }
}

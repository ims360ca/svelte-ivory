{
    "name": "@ims360/svelte-ivory",
    "version": "0.4.20",
    "keywords": [
        "svelte"
    ],
    "license": "MIT",
    "sideEffects": [
        "**/*.css"
    ],
    "type": "module",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ims360ca/svelte-ivory.git"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        },
        "./components/basic": {
            "types": "./dist/components/basic/index.d.ts",
            "svelte": "./dist/components/basic/index.js"
        },
        "./components/layout": {
            "types": "./dist/components/layout/index.d.ts",
            "svelte": "./dist/components/layout/index.js"
        },
        "./components/table": {
            "types": "./dist/components/table/index.d.ts",
            "svelte": "./dist/components/table/index.js"
        },
        "./components/toast": {
            "types": "./dist/components/toast/index.d.ts",
            "svelte": "./dist/components/toast/index.js"
        },
        "./components/inputs": {
            "types": "./dist/components/inputs/index.d.ts",
            "svelte": "./dist/components/inputs/index.js"
        },
        "./utils/attachments": {
            "types": "./dist/utils/attachments/index.d.ts",
            "svelte": "./dist/utils/attachments/index.js"
        },
        "./utils/functions": {
            "types": "./dist/utils/functions/index.d.ts",
            "svelte": "./dist/utils/functions/index.js"
        }
    },
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src/lib",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*",
        "!src/lib/**/*.test.*",
        "!src/lib/**/*.spec.*"
    ],
    "scripts": {
        "build": "vite build && npm run prepack",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "dev": "vite dev",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepack": "svelte-kit sync && svelte-package && publint",
        "prepare": "svelte-kit sync || echo ''",
        "preview": "vite preview",
        "test": "npm run test:unit -- --run",
        "test:unit": "vitest"
    },
    "dependencies": {
        "@lucide/svelte": "^0.553.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.2.1",
        "clsx": "^2.1.1",
        "dompurify": "^3.3.1",
        "jsdom": "^27.4.0",
        "marked": "^17.0.4",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.1"
    },
    "devDependencies": {
        "@eslint/compat": "^2.0.2",
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/package": "^2.5.7",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.3.1",
        "@testing-library/user-event": "^14.6.1",
        "@vitest/browser": "^4.0.18",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/spy": "^4.0.18",
        "eslint": "^10.0.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.15.0",
        "globals": "^16.5.0",
        "playwright": "^1.58.2",
        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "^3.5.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "publint": "^0.3.18",
        "svelte-check": "^4.4.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1",
        "vite": "^7.3.1",
        "vitest": "^4.0.18",
        "zod": "^4.3.6"
    },
    "peerDependencies": {
        "@skeletonlabs/skeleton": "^4.0.0",
        "@sveltejs/kit": "^2.49.5",
        "svelte": "^5.46.4"
    }
}
